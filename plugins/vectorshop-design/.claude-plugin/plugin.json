{
  "name": "vectorshop-design",
  "version": "1.4.0",
  "description": "VectorShop 设计 MCP server:免费出 1x 成品图与 .vsp 源文件;App 内精修与 2x/3x 高清需 App Pro",
  "author": {
    "name": "chenyunguiMilook"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/ensure-vectorshop.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_vectorshop-design_vectorshop__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/allow-own-tools.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
